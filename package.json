{
  "name": "kultist-color-theme",
  "displayName": "Kultist color theme",
  "description": "A black and minimal theme: monochrome greys for syntax, warm literals, red only for errors",
  "version": "2.0.0",
  "author": {
    "name": "codekult"
  },
  "publisher": "codekult",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "black",
    "monochrome",
    "minimal"
  ],
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/codekult/kultist-color-theme.git"
  },
  "homepage": "https://github.com/codekult/kultist-color-theme/blob/master/README.md",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "bugs": {
    "url": "https://github.com/codekult/kultist-color-theme/issues"
  },
  "contributes": {
    "themes": [
      {
        "id": "Kultist",
        "label": "Kultist",
        "uiTheme": "vs-dark",
        "path": "./themes/kultist-color-theme.json"
      },
      {
        "id": "Kultist Classic",
        "label": "Kultist Classic",
        "uiTheme": "vs-dark",
        "path": "./themes/kultist-classic-color-theme.json"
      }
    ]
  },
  "scripts": {
    "package": "vsce package",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "ovsx": "^1.2.0"
  }
}
